# Configuration pour le service d'alertes MediBot
# Copiez ce fichier en .env et ajustez les valeurs selon votre configuration

# URL du dashboard Flask pour recevoir les alertes
# Par défaut: http://localhost:5000/api/alerts
DASHBOARD_URL=http://localhost:5000/api/alerts

# Chemin vers la base de données
# Par défaut: database/medibot.db
DB_PATH=database/medibot.db

# Configuration Robot Pepper (NAOqi)
# Adresse IP du robot Pepper sur le réseau
PEPPER_IP=192.168.1.100
# Port NAOqi (9559 par défaut)
PEPPER_PORT=9559
